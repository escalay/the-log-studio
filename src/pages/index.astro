---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Navbar from '@/layout/Navbar.astro'
import Hero from '@/layout/Hero.astro'
import JournalPreview from '@/layout/JournalPreview.astro'
import { Footer } from '@/layout/Footer'
import { CollectionApp } from '@/collection/CollectionApp'
import { createDb } from '@/db'
import { entries } from '../../drizzle/schema'
import { eq, or } from 'drizzle-orm'

// Older links opened an entry with ?entry=<id>: send them to the entry's own page
const linked = Astro.url.searchParams.get('entry')
if (linked) {
  const db = createDb(Astro.locals.runtime.env.DB)
  const found = await db.select({ slug: entries.slug }).from(entries).where(or(eq(entries.id, linked), eq(entries.slug, linked)))
  if (found[0]) return Astro.redirect(`/entries/${found[0].slug}`, 301)
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'The Log Studio',
  description: 'The operating system for ideas. A brutalist digital garden tracking the evolution of experiments from raw notes to shipped products.',
  url: 'https://escalay.space',
  publisher: {
    '@type': 'Organization',
    name: 'Escalay',
    url: 'https://escalay.space',
  },
}
---

<BaseLayout jsonLd={jsonLd}>
  <div class="min-h-screen flex flex-col font-sans text-ink bg-dot-grid relative overflow-x-hidden w-full">
    <Navbar active="collection" />
    <Hero />
    <main id="main" class="flex-1 relative container mx-auto max-w-7xl md:border-x md:border-ink bg-paper">
      <CollectionApp client:load />
    </main>
    <JournalPreview />
    <Footer client:idle />
  </div>
</BaseLayout>
